# Скопируйте в backend/.env и при необходимости поменяйте.
# Значения совпадают с docker-compose.dev.yml.
DATABASE_URL=postgresql+asyncpg://anifolder:anifolder@localhost:5432/anifolder
DB_ECHO=false

# Авторизация: JWT access-токен (15 минут) и refresh-токен (30 дней).
# Секрет должен быть не короче 32 байт; никогда не коммитьте реальный секрет.
JWT_SECRET=change-me-to-a-long-random-string-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Redis: кэш каталога и рекомендаций (подключается на этапе каталога)
REDIS_URL=redis://localhost:6379/0

# Origins фронтенда для CORS (через запятую)
CORS_ORIGINS=http://localhost:5173
